// Enterprise PostgreSQL Production schema for Real-Time National Land Acquisition & Management System
// Ministry of Rural Development, Government of India (RFCTLARR Act 2013)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String     @id @default(uuid())
  email          String     @unique
  passwordHash   String
  name           String
  designation    String
  role           String
  state          String?
  district       String?
  department     String?
  phone          String?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  auditLogs      AuditLog[]
}

model Project {
  id                   String            @id @default(uuid())
  code                 String            @unique
  name                 String
  description          String
  sector               String
  requisitioningAgency String
  state                String
  district             String
  totalAreaHectares    Float
  estimatedBudgetCr    Float
  compensationBudgetCr Float
  currentStage         String            @default("STAGE_1_REQUISITION")
  status               String            @default("SUBMITTED")
  riskScore            Float             @default(15.0)
  riskLevel            String            @default("LOW")
  statutoryLapseDeadline DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  notifications        Notification[]
  parcels              LandParcel[]
  displacedFamilies    DisplacedFamily[]
}

model Notification {
  id                 String    @id @default(uuid())
  projectId          String
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section            String
  gazetteNumber      String
  issueDate          DateTime
  expiryDate         DateTime?
  newspaperLocal1    String?
  newspaperLocal2    String?
  documentUrl        String?
  status             String    @default("PUBLISHED")
  objectionsCount    Int       @default(0)
  objectionsResolved Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model LandParcel {
  id                  String           @id @default(uuid())
  projectId           String
  project             Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  village             String
  tehsil              String
  khasraNumber        String
  areaAcres           Float
  landType            String
  ownerName           String
  ownerAadhaarMasked  String?
  ownerBankAccMasked  String?
  ownerIfsc           String?
  status              String           @default("NOTIFIED")
  latitude            Float
  longitude           Float
  geometryGeoJSON     String?
  treesCount          Int              @default(0)
  structuresCount     Int              @default(0)
  fieldNotes          String?
  lastSurveyedAt      DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  valuationAward      ValuationAward?
}

model ValuationAward {
  id                       String         @id @default(uuid())
  parcelId                 String         @unique
  parcel                   LandParcel     @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  baseRatePerAcre          Float
  marketValueLand          Float
  ruralMultiplier          Float          @default(1.5)
  multipliedMarketValue    Float
  assetsValue              Float          @default(0)
  subTotalBeforeSolatium   Float
  solatiumAmount           Float
  daysBetweenSec11AndAward Int            @default(0)
  additionalInterestAmount Float          @default(0)
  totalAwardAmount         Float
  awardDate                DateTime       @default(now())
  status                   String         @default("APPROVED_COLLECTOR")
  approvedBy               String?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  disbursements            Disbursement[]
}

model Disbursement {
  id              String         @id @default(uuid())
  awardId         String
  award           ValuationAward @relation(fields: [awardId], references: [id], onDelete: Cascade)
  beneficiaryName String
  amountPaid      Float
  paymentMode     String         @default("PFMS_DBT")
  utrReference    String         @unique
  paymentDate     DateTime       @default(now())
  status          String         @default("SUCCESS")
  remarks         String?
  createdAt       DateTime       @default(now())
}

model DisplacedFamily {
  id                       String   @id @default(uuid())
  projectId                String
  project                  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  familyHeadName           String
  category                 String
  membersCount             Int
  isLosingHomestead        Boolean  @default(false)
  isLosingLivelihood       Boolean  @default(false)
  housingEntitlementStatus String   @default("PENDING")
  subsistenceGrantPaid     Boolean  @default(false)
  resettlementAllowancePaid Boolean @default(false)
  overallRRStatus          String   @default("SURVEYED")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userRole      String
  action        String
  entityType    String
  entityId      String
  ipAddress     String   @default("127.0.0.1")
  previousState String?
  newState      String?
  createdAt     DateTime @default(now())
}
